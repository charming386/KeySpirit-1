<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KeySpirit</AssemblyName>
    <RootNamespace>KeySpirit</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.12.1</Version>
    <Product>键灵</Product>
    <AssemblyTitle>键灵</AssemblyTitle>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 内存：工作站 GC（非服务端），关闭并发 GC 后台线程 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 图标是运行时按文件读的（IconCache 走 AppContext.BaseDirectory + Assets\x.ico），
         单文件发布默认会把 .ico 打包进 exe、发布目录里就不留文件了，运行时读不到 → 菜单里的图标全空。
         所以强制这些 ico 留在 exe 旁边。 -->
    <Content Update="Assets\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
